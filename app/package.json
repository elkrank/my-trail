{
  "name": "trailcompare",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "lint": "node --check public/app.js && node --check public/profile-comparison.js && node --check public/profile-repository.js && node --check src/server.js && node --check src/repository.js",
    "build": "npm run lint && npm run report:assets",
    "scrape": "node scrapers/cli.mjs",
    "scrape:gpx": "node scrapers/cli.mjs --gpx-only",
    "test": "node --test tests/*.test.js tests/scrapers/*.test.mjs",
    "report:difficulty": "node scripts/difficulty-v1-report.mjs",
    "report:course-pages": "node scripts/audit-course-pages.mjs",
    "report:assets": "node scripts/audit-data-assets.mjs",
    "report:quality": "node scripts/data-quality-report.mjs --write",
    "clean:assets": "node scripts/audit-data-assets.mjs --delete"
  },
  "dependencies": {
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "pdf-parse": "^1.1.1"
  }
}
